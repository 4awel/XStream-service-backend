# Шаблон для локальной разработки: cp .env.example .env
# Секреты генерируются так: openssl rand -hex 32

NODE_ENV=development

APPLICATION_PORT=4000
APPLICATION_URL=http://localhost:4000
# Через запятую, если фронт открывается с нескольких адресов.
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECRET=change_me

POSTGRES_PASSWORD=root
POSTGRES_USERNAME=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DATABASE=stream_service
POSTGRES_URL=postgresql://postgres:root@localhost:5433/stream_service?schema=public
DATABASE_URL=postgresql://postgres:root@localhost:5433/stream_service?schema=public

REDIS_USER=default
REDIS_PASSWORD=redispassword
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://default:redispassword@localhost:6379

SESSION_SECRET=change_me
VERIFICATION_CODE_SECRET=change_me
SESSION_NAME=sid
SESSION_DOMAIN=localhost
SESSION_MAX_AGE=7d
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_SAME_SITE=lax
SESSION_PREFIX=sess:

JWT_SECRET=change_me
LOGO_XS_APP_URL=

# Письма в dev ловит mailpit из docker-compose: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASSWORD=dev
MAIL_FROM=no-reply@localhost

# --- MediaMTX / стрим ---
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_SYNC_INTERVAL_MS=10000
STREAM_KEY_SECRET=change_me_64_hex_chars
STREAM_HOOK_SECRET=change_me_64_hex_chars
