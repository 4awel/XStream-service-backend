# Шаблон для прода: cp .env.production.example .env.production
# Файл читает и docker-compose.prod.yml (env_file), и само приложение.
# Все секреты — свежие: openssl rand -hex 32
#
# Запуск:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

NODE_ENV=production

APPLICATION_PORT=4000
APPLICATION_URL=https://api.example.com
ALLOWED_ORIGINS=https://example.com,https://www.example.com
COOKIE_SECRET=

# Хосты — имена сервисов из docker-compose.prod.yml, а не localhost.
POSTGRES_PASSWORD=
POSTGRES_USERNAME=stream
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=stream_service
POSTGRES_URL=postgresql://stream:PASSWORD@db:5432/stream_service?schema=public
DATABASE_URL=postgresql://stream:PASSWORD@db:5432/stream_service?schema=public

REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://default:PASSWORD@redis:6379

SESSION_SECRET=
VERIFICATION_CODE_SECRET=
SESSION_NAME=sid
# Домен cookie: точка впереди, если фронт на поддомене.
SESSION_DOMAIN=.example.com
SESSION_MAX_AGE=7d
SESSION_HTTP_ONLY=true
# В проде обязательно true, иначе сессия поедет открытым текстом.
SESSION_SECURE=true
# Фронт и API на разных доменах -> none. На одном домене можно оставить lax.
SESSION_SAME_SITE=none
SESSION_PREFIX=sess:

JWT_SECRET=
LOGO_XS_APP_URL=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- MediaMTX / стрим ---
# RTMP и HLS/WebRTC — публичные адреса (их видят OBS и браузеры зрителей).
# API — внутреннее имя сервиса: порт 9997 наружу не публикуется.
MEDIAMTX_RTMP_URL=rtmp://media.example.com:1935
MEDIAMTX_HLS_URL=https://media.example.com
MEDIAMTX_WEBRTC_URL=https://media.example.com/webrtc
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_SYNC_INTERVAL_MS=10000
STREAM_KEY_SECRET=
STREAM_HOOK_SECRET=
