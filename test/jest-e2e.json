{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts",
    "tsx"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [
    ".ts",
    ".tsx"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^@prisma/generated/(.*)$": "<rootDir>/../prisma/generated/$1"
  },
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "<rootDir>/tsconfig.e2e.json"
      }
    ]
  },
  "testTimeout": 30000,
  "maxWorkers": 1
}